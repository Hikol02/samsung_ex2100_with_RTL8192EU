# CONFIG_SENSORS_STK3A8X is not set
# CONFIG_SENSORS_FLIP_COVER_DETECTOR is not set
# CONFIG_SENSORS_SSP_R9S is not set
# CONFIG_HALL_NOTIFIER is not set
# CONFIG_HALL_LOGICAL is not set
# CONFIG_PWM_CONFIG is not set

CONFIG_MOTOR_CS40L2X=m
CONFIG_CS40L2X_SAMSUNG_FEATURE=y
# CONFIG_MAX77705_VIBRATOR is not set

CONFIG_TOUCHSCREEN_SLSI=m
# CONFIG_TOUCHSCREEN_SYNAPTICS is not set

CONFIG_SAMSUNG_UWB=m
CONFIG_UWB_SR100=y
CONFIG_SEC_UWB_LOGGER=y

CONFIG_TX_GEAR_AOV=y

CONFIG_EPEN_WACOM_WEZ01=m
CONFIG_EPEN_WACOM_W9020=y

CONFIG_PD_CHARGER_HV_DISABLE=y

CONFIG_EROFS_FS_PCPU_KTHREAD=y

# CONFIG_SECTION_MISMATCH_WARN_ONLY is not set
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MT76_CORE=y
CONFIG_MT76_USB=y
CONFIG_MT76x02_LIB=y
CONFIG_MT76x02_USB=y
CONFIG_MT76x0_COMMON=y
CONFIG_MT76x0U=y
CONFIG_EXTRA_FIRMWARE="mediatek/mt7610u.bin"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"

# Wi-Fi drivers (MT7610U + RTL8192EU) & Firmware
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MT76_CORE=y
CONFIG_MT76_USB=y
CONFIG_MT76x02_LIB=y
CONFIG_MT76x02_USB=y
CONFIG_MT76x0_COMMON=y
CONFIG_MT76x0U=y
CONFIG_RTL8192EU=y
CONFIG_EXTRA_FIRMWARE="mediatek/mt7610u.bin"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT76_CORE=y
CONFIG_MT76_USB=y
CONFIG_MT76x02_LIB=y
CONFIG_MT76x02_USB=y
CONFIG_MT76x0_COMMON=y
CONFIG_MT76x0U=y

# Обязательно для работы X11/Wayland, D-Bus и KDE
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# Контейнеризация, изоляция и systemd внутри контейнера
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y

# Файловые системы и образы дисков (для монтирования rootfs из файла .img)
CONFIG_BLK_DEV_LOOP=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# Виртуальные терминалы и ввод (нужно для libinput и клавиатуры/мыши)
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
