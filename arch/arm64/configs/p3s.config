# CONFIG_EXYNOS_DECON_LCD_S6E3FC3 is not set

# CONFIG_LEDS_KTD2692 is not set
CONFIG_LEDS_S2MPB02=m

CONFIG_USE_LLC_LOG=m
CONFIG_USE_PPC_LOG=m
CONFIG_DEBUG_SNAPSHOT_LOG_ITEM_SIZE=1024

CONFIG_SENSORS=y
CONFIG_SENSORS_SX9364=m
