# Config file for p3s (Galaxy S21 Ultra 5G)
# This is merged with exynos2100_defconfig on build

CONFIG_MODEL_P3S=y

# CONFIG_RBIN is not set

# CONFIG_SEC_NFC_LOGGER_ADD_ACPM_LOG is not set

# CONFIG_USB_NET_AQC111 is not set
# CONFIG_BCM4375 is not set
CONFIG_BCM4389=m

